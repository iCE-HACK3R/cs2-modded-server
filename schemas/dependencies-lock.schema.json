{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iCE-HACK3R/cs2-modded-server/schemas/dependencies-lock.schema.json",
  "title": "CS2 Modded Server dependency lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "allowedHosts", "dependencies"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "allowedHosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dependency" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)[^/]*[. ](?:/|$))(?!.*[\\\\:<>\"|?*\\u0000-\\u001f])(?!.*\/$).+$",
      "not": {
        "pattern": "(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$)"
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "upstream", "license", "required", "modes", "assets"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "upstream": { "type": "string", "format": "uri", "pattern": "^https://" },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx", "url", "notice"],
          "properties": {
            "spdx": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri", "pattern": "^https://" },
            "notice": { "type": "string", "minLength": 1 }
          }
        },
        "required": { "type": "boolean" },
        "modes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/asset" }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "variant", "url", "sha256", "size", "archive", "expandedSizeLimit", "expectedPaths", "managedPaths", "seedPaths"],
      "properties": {
        "platform": { "enum": ["linux-x64", "windows-x64"] },
        "variant": { "enum": ["framework-dependent", "with-runtime"] },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 1 },
        "archive": { "enum": ["zip", "tar.gz"] },
        "expandedSizeLimit": { "type": "integer", "minimum": 1 },
        "expectedPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "managedPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "seedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        }
      }
    }
  }
}
